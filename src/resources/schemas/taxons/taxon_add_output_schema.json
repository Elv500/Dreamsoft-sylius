{
    "type": "object",
    "required": [
        "@context",
        "@id",
        "@type",
        "id",
        "code",
        "parent",
        "children",
        "position",
        "translations",
        "enabled",
        "images"
    ],
    "properties": {
        "@context": { "type": "string", "format": "uri-reference" },
        "@id": { "type": "string", "format": "uri-reference" },
        "@type": { "type": "string", "const": "Taxon" },
        "id": { "type": "integer", "minimum": 1 },
        "code": { "type": "string" },
        "parent": {
            "oneOf": [
                { "type": "string", "format": "uri-reference" },
                { "type": "null" }
            ]
        },
        "children": {
            "type": "array",
            "items": { "type": "string", "format": "uri-reference" }
        },
        "position": {
            "type": "integer", "minimum": 0
        },
        "enabled": {
            "type": "boolean"
        },
        "images": {
            "type": "array"
        },
        "translations": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                "^[a-z]{2}_[A-Z]{2}$": {
                    "type": "object",
                    "required": [
                        "@id",
                        "@type",
                        "id",
                        "name",
                        "slug",
                        "description"
                    ],
                    "properties": {
                        "@id": { "type": "string", "format": "uri-reference" },
                        "@type": { "type": "string", "const": "TaxonTranslation" },
                        "id": { "type": "integer", "minimum": 1 },
                        "name": { "type": "string", "minLength": 1 },
                        "slug": { "type": "string", "minLength": 1 },
                        "description": {
                            "type": ["string", "null"]
                        }
                    }
                }
            }
        }
    }
}